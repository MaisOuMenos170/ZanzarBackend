NODE_ENV=development
PORT=3000
# Atlas (produção/dev remoto)
MONGODB_URI=mongodb+srv://<user>:<pass>@clusterzanzar.9lbgwfu.mongodb.net/Zanzardb
# Obrigatório se mongodb+srv falhar com "querySrv EBADRESP" (DNS local). Copie do Atlas → Connect → Drivers → "Standard connection string".
MONGODB_URI_STANDARD=mongodb://ac-yatndwg-shard-00-00.9lbgwfu.mongodb.net:27017,ac-yatndwg-shard-00-01.9lbgwfu.mongodb.net:27017,ac-yatndwg-shard-00-02.9lbgwfu.mongodb.net:27017/Zanzardb?ssl=true&replicaSet=atlas-1hpih3-shard-0
# Local (opcional)
# MONGODB_URI=mongodb://127.0.0.1:27017/Zanzardb
JWT_SECRET=
JWT_REFRESH_SECRET=
# Bundle ID do app iOS (aud do identityToken da Apple). Aceita vários, separados por vírgula. Sem ele, POST /login/apple responde 503.
APPLE_BUNDLE_ID=
CHECKIN_RADIUS_METERS=150
GOOGLE_PLACES_API_KEY=
# Busca de lugares sugeridos (OpenStreetMap/Nominatim). A política do Nominatim exige um User-Agent que identifique o app
# e um contato real em produção, ex.: "ZanzarBackend/1.0 (contato@seudominio.com)". O servidor público limita a 1 req/s.
OSM_USER_AGENT=
# Troque por uma instância própria (ou provedor pago) se o volume crescer.
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# POST /register is blocked when NODE_ENV=development. Set true to register accounts locally.
SIGNUP_ENABLED=false
# debug | info | warn | error | fatal | silent (see README "Logging")
LOG_LEVEL="info"
# Fotos de usuário (ver ../Zanzar/docs/fotos-de-usuario-decisao.md)
# disk (padrão fora de produção, grava em PHOTO_STORAGE_DIR) | supabase. Em produção sem isso, o envio responde 503.
PHOTO_STORAGE=
PHOTO_STORAGE_DIR=
# URL base das fotos no modo disk (o simulador precisa alcançar). Padrão: http://127.0.0.1:$PORT
PHOTO_PUBLIC_BASE_URL=
SUPABASE_URL=
# Chave service_role: só no servidor, nunca no app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=
SUPABASE_PUBLIC_BUCKET=
# Camada de visão (endpoint compatível com OpenAI). Sem ela, toda foto vai para revisão humana.
# Cloudflare: https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1/chat/completions
# Ollama local: http://127.0.0.1:11434/v1/chat/completions
VISION_API_URL=
VISION_API_KEY=
# Cloudflare: @cf/mistralai/mistral-small-3.1-24b-instruct | Ollama: mistral-small3.1:24b
VISION_MODEL=
VISION_TIMEOUT_MS=
# Ids (ObjectId) das contas da equipe que podem moderar fotos em /admin, separados por vírgula. Vazio: ninguém.
ADMIN_USER_IDS=

# APNs (Apple Push Notifications) — para pushes de reengajamento (inatividade, roteiro inacabado, streak).
# No Railway, use APNS_AUTH_KEY com o conteúdo direto do .p8 (não há sistema de arquivos persistente).
# Copie TODO o conteúdo do arquivo AuthKey_XXXXXXXXXX.p8, incluindo as linhas -----BEGIN/END PRIVATE KEY-----.
# APNS_AUTH_KEY=-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----
# APNS_KEY_ID=77R3896M3V
# APNS_TEAM_ID=SEU_TEAM_ID
# APNS_BUNDLE_ID=dalpra.Zanzar
# Necessário apenas em produção. Obtenha a chave .p8 no Apple Developer > Certificates, IDs & Profiles > Keys.
# APNS_AUTH_KEY_PATH=/caminho/para/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=com.seudominio.Zanzar
# Dias sem check-in antes de enviar push de inatividade (padrão 3).
# PUSH_INACTIVITY_DAYS=3
# Intervalo mínimo entre pushes de inatividade para o mesmo usuário, em dias (padrão 7).
# PUSH_INACTIVITY_COOLDOWN_DAYS=7
