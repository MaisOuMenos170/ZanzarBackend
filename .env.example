NODE_ENV=development
PORT=3000
# Atlas (produção/dev remoto)
MONGODB_URI=mongodb+srv://<user>:<pass>@clusterzanzar.9lbgwfu.mongodb.net/Zanzardb
# Obrigatório se mongodb+srv falhar com "querySrv EBADRESP" (DNS local). Copie do Atlas → Connect → Drivers → "Standard connection string".
MONGODB_URI_STANDARD=mongodb://ac-yatndwg-shard-00-00.9lbgwfu.mongodb.net:27017,ac-yatndwg-shard-00-01.9lbgwfu.mongodb.net:27017,ac-yatndwg-shard-00-02.9lbgwfu.mongodb.net:27017/Zanzardb?ssl=true&replicaSet=atlas-1hpih3-shard-0
# Local (opcional)
# MONGODB_URI=mongodb://127.0.0.1:27017/Zanzardb
JWT_SECRET=
JWT_REFRESH_SECRET=
# Bundle ID do app iOS (aud do identityToken da Apple). Aceita vários, separados por vírgula. Sem ele, POST /login/apple responde 503.
APPLE_BUNDLE_ID=
CHECKIN_RADIUS_METERS=150
GOOGLE_PLACES_API_KEY=
# POST /register is blocked when NODE_ENV=development. Set true to register accounts locally.
SIGNUP_ENABLED=false
# debug | info | warn | error | fatal | silent (see README "Logging")
LOG_LEVEL="info"
# Fotos de usuário (ver ../Zanzar/docs/fotos-de-usuario-decisao.md)
# disk (padrão fora de produção, grava em PHOTO_STORAGE_DIR) | supabase. Em produção sem isso, o envio responde 503.
PHOTO_STORAGE=
PHOTO_STORAGE_DIR=
# URL base das fotos no modo disk (o simulador precisa alcançar). Padrão: http://127.0.0.1:$PORT
PHOTO_PUBLIC_BASE_URL=
SUPABASE_URL=
# Chave service_role: só no servidor, nunca no app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=
SUPABASE_PUBLIC_BUCKET=
# Camada de visão (endpoint compatível com OpenAI). Sem ela, toda foto vai para revisão humana.
# Cloudflare: https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1/chat/completions
# Ollama local: http://127.0.0.1:11434/v1/chat/completions
VISION_API_URL=
VISION_API_KEY=
# Cloudflare: @cf/mistralai/mistral-small-3.1-24b-instruct | Ollama: mistral-small3.1:24b
VISION_MODEL=
VISION_TIMEOUT_MS=
