# Railway → environment "development" (deploys branch `develop`)
# Set these as variables in the Railway dashboard; do not commit real values.
# PORT is injected by Railway.
NODE_ENV=development
# Dev Atlas cluster (separate from production). Keep the database name Zanzardb.
MONGODB_URI=mongodb+srv://<dev-user>:<dev-pass>@<dev-cluster>.mongodb.net/Zanzardb
# Generate with: openssl rand -base64 48 — must differ from production
JWT_SECRET=
# Generate with: openssl rand -base64 48 — must differ from JWT_SECRET and from production
JWT_REFRESH_SECRET=
# Bundle ID do app iOS (aud do identityToken da Apple); vários separados por vírgula. Sem ele, POST /login/apple responde 503.
APPLE_BUNDLE_ID=
CHECKIN_RADIUS_METERS=150
LOG_LEVEL=debug
# Signup (POST /register) is blocked when NODE_ENV=development. Uncomment to open it temporarily.
# SIGNUP_ENABLED=true

# APNs (Apple Push Notifications) — para pushes de reengajamento.
# No Railway, use APNS_AUTH_KEY com o conteúdo direto do .p8.
# APNS_AUTH_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_KEY_ID=77R3896M3V
# APNS_TEAM_ID=SEU_TEAM_ID
# APNS_BUNDLE_ID=dalpra.Zanzar
# APNS_AUTH_KEY_PATH=/caminho/para/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=com.seudominio.Zanzar
# PUSH_INACTIVITY_DAYS=3
# PUSH_INACTIVITY_COOLDOWN_DAYS=7
