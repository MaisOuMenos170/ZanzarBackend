# Railway → environment "development" (deploys branch `develop`)
# Set these as variables in the Railway dashboard; do not commit real values.
# PORT is injected by Railway.
NODE_ENV=development
# Dev Atlas cluster (separate from production). Keep the database name Zanzardb.
MONGODB_URI=mongodb+srv://<dev-user>:<dev-pass>@<dev-cluster>.mongodb.net/Zanzardb
# Generate with: openssl rand -base64 48 — must differ from production
JWT_SECRET=
CHECKIN_RADIUS_METERS=150
LOG_LEVEL=debug
# Signup (POST /register) is blocked when NODE_ENV=development. Uncomment to open it temporarily.
# SIGNUP_ENABLED=true
