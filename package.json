{
  "name": "zanzar-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Zanzar API — base do projeto (Express + Mongoose + MongoDB + JWT)",
  "type": "module",
  "scripts": {
    "setup:collections": "bash scripts/setup-zanzardb-collections.sh",
    "seed": "bash scripts/seed-zanzardb.sh",
    "sync:lugares": "bash scripts/sync-lugares-from-github.sh",
    "atlas:ip": "bash scripts/atlas-ip.sh",
    "db:init": "bash scripts/setup-zanzardb-collections.sh || true; bash scripts/seed-zanzardb.sh",
    "db:validate": "bash scripts/apply-zanzardb-validation.sh",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
