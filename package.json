{
  "name": "zanzarbackend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "npx tsc && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node scripts/seed/lugares-inference.test.js && tsx src/events/triggers/itinerary-progress.test.ts",
    "setup:collections": "bash scripts/setup/setup-collections.sh",
    "seed": "bash scripts/seed/seed-zanzardb.sh",
    "sync:lugares": "bash scripts/seed/sync-lugares-from-github.sh",
    "atlas:ip": "bash scripts/dev/atlas-ip.sh",
    "db:init": "bash scripts/setup/setup-collections.sh || true; bash scripts/seed/seed-zanzardb.sh",
    "db:validate": "tsx scripts/validators/apply-validators.ts",
    "db:validate:dry": "tsx scripts/validators/apply-validators.ts --dry-run",
    "tunnel": "bash scripts/dev/dev-tunnel.sh",
    "typecheck": "tsc --noEmit",
    "db:migrate:geo": "bash scripts/migrations/migrate-places-geolocation.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "nodemon": "^3.1.14",
    "tsconfig": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  }
}
