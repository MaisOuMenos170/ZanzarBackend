# Railway → environment "production" (deploys branch `main`)
# Set these as variables in the Railway dashboard; do not commit real values.
# PORT is injected by Railway.
NODE_ENV=production
# Production Atlas cluster (separate from development). Keep the database name Zanzardb.
MONGODB_URI=mongodb+srv://<prod-user>:<prod-pass>@<prod-cluster>.mongodb.net/Zanzardb
# Generate with: openssl rand -base64 48 — at least 32 chars (the server refuses to start otherwise); must differ from development
JWT_SECRET=
# Generate with: openssl rand -base64 48 — at least 32 chars; must differ from JWT_SECRET and from development
JWT_REFRESH_SECRET=
# Bundle ID do app iOS (aud do identityToken da Apple); vários separados por vírgula. Sem ele, POST /login/apple responde 503.
APPLE_BUNDLE_ID=
CHECKIN_RADIUS_METERS=150
LOG_LEVEL=info

# APNs (Apple Push Notifications) — obrigatório em produção.
# No Railway, use APNS_AUTH_KEY com o conteúdo direto do .p8.
# APNS_AUTH_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APNS_KEY_ID=77R3896M3V
# APNS_TEAM_ID=SEU_TEAM_ID
# APNS_BUNDLE_ID=dalpra.Zanzar
# PUSH_INACTIVITY_DAYS=3
# PUSH_INACTIVITY_COOLDOWN_DAYS=7
